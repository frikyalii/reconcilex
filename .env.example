# ReconcileX Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Never commit real production secrets to version control.

APP_NAME=ReconcileX
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000

# Primary Database (PostgreSQL in Docker/production, SQLite for lightweight local/tests)
DATABASE_URL=sqlite:///./reconcilex.db
# DATABASE_URL=postgresql+psycopg://reconcilex:reconcilex_dev_pass@localhost:5432/reconcilex
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# Qdrant Vector Store (Optional for semantic historical incident lookup)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_INCIDENTS=reconcilex_incidents
QDRANT_ENABLED=false

# Open-Source Agentic AI Settings
# Set LLM_PROVIDER=huggingface_api and provide HF_API_TOKEN (hf_...) to call live Hugging Face Inference API!
# Or keep LLM_PROVIDER=mock for offline/zero-key local testing.
LLM_PROVIDER=mock
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HF_API_TOKEN=
HF_INFERENCE_API_URL=https://router.huggingface.co/hf-inference/models
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30

# Security & Operational Controls
SECRET_KEY=replace-with-strong-32-byte-secret-in-production
OPERATOR_API_KEYS=dev-operator-key:operator,dev-admin-key:admin,dev-viewer-key:viewer
MAX_UPLOAD_BYTES=10485760
DEFAULT_CURRENCY=INR
STALE_EVENT_WINDOW_SECONDS=3600

# Observability
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=reconcilex-backend
